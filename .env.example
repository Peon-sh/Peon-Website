# Peon marketing site (peon.sh)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Tag Manager container ID. Leave empty to disable.
NEXT_PUBLIC_GTM_ID=

# Meta Pixel ID. Leave empty to disable.
NEXT_PUBLIC_META_PIXEL_ID=

# Read-only peon-analytics Postgres (published blogs + blog-sitemap)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/peon-analytics?schema=public

# Optional sponsorship destinations (/open-source)
# NEXT_PUBLIC_GITHUB_SPONSORS_URL=https://github.com/sponsors/hironate
# NEXT_PUBLIC_OPEN_COLLECTIVE_URL=https://opencollective.com/peon
# NEXT_PUBLIC_STRIPE_DONATE_URL=https://buy.stripe.com/00w9ANd2u5Occ7k7EU4sE00
